#!/usr/bin/env python3
"""Download and install the recommended workspace release; no existing ws needed."""
import sys
from pathlib import Path

if sys.version_info < (3, 6):
    sys.exit('Workspace setup requires Python 3.6 or newer.')
sys.path.insert(0, str(Path(__file__).resolve().parent / 'lib'))
from bootstrap import main

if __name__ == '__main__':
    sys.exit(main())
