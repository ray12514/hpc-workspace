        # commands without adding a hook that the site has made read-only.
        eval "$(zoxide init bash --hook none)"
    else
        eval "$(zoxide init bash)"
    fi
    alias ll='eza --long --all --group-directories-first --icons=never'
fi
unset _ws_prompt_readonly
if [[ -f /workspace-tools/config/codex-native-key.bash ]]; then
    source /workspace-tools/config/codex-native-key.bash
fi
if [[ -f "${HOME}/.config/hpc-workspace/bashrc" ]]; then
    source "${HOME}/.config/hpc-workspace/bashrc"
fi
# Restore the Bash builtin before composing the final prompt.
unset -f readonly
# A personal/site startup file can replace and freeze PROMPT_COMMAND after the
# workspace first composes it. Recheck after every startup file has run.
_ws_late_prompt_readonly=''
while IFS= read -r _ws_readonly_line; do
    if [[ $_ws_readonly_line =~ ^declare\ -[a-zA-Z]*r[a-zA-Z]*\ PROMPT_COMMAND($|=) ]]; then
        _ws_late_prompt_readonly=1
        break
    fi
done < <(readonly -p)
