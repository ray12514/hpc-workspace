    # still owns prompt refreshes.
    _ws_prompt_template=$PS1 _ws_prompt_applied=$PS1
fi
unset _ws_prompt_readonly_requested _ws_late_prompt_readonly _ws_readonly_line _ws_prompt_hook_present _ws_prompt_item
