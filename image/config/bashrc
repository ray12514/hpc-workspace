# The thin layout preserves the calling system's paths and module environment.
# Site startup can freeze PROMPT_COMMAND before the workspace has a chance to
# preserve it. Defer only that one readonly declaration until the complete
# site command has been placed between the workspace's prompt hooks. All
# other readonly declarations keep their normal Bash behavior.
_ws_prompt_readonly_requested=''
readonly() {
    local _ws_readonly_arg _ws_readonly_other=0 _ws_readonly_defer=''
    local -a _ws_readonly_args=()
    for _ws_readonly_arg in "$@"; do
        case $_ws_readonly_arg in
            PROMPT_COMMAND)
                _ws_readonly_defer=1
                ;;
            PROMPT_COMMAND=*)
                PROMPT_COMMAND=${_ws_readonly_arg#PROMPT_COMMAND=}
                _ws_readonly_defer=1
                ;;
            *)
                _ws_readonly_args+=("$_ws_readonly_arg")
                [[ $_ws_readonly_arg != -* && $_ws_readonly_arg != -- ]] && _ws_readonly_other=1
                ;;
        esac
    done
    if [[ $_ws_readonly_defer == 1 ]]; then
        _ws_prompt_readonly_requested=1
        if (( _ws_readonly_other )); then
            builtin readonly "${_ws_readonly_args[@]}" || return
        fi
        return 0
    else
        builtin readonly "$@"
    fi
}
if [[ ${WS_LAYOUT:-core} != thin-v1 ]]; then
    export PATH="/opt/workspace/bin:/opt/nvim/bin:/opt/workspace/node_modules/.bin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
fi
if [[ ${WS_LAYOUT:-core} == thin-v1 && ${WS_SHELL_PREFLIGHT:-} != 1 ]] && ! declare -F module >/dev/null; then
    _ws_lmod=${LMOD_CMD:-/nonexistent}
    for _ws_module_init in "${MODULESHOME:-/nonexistent}/init/bash" "${_ws_lmod%/libexec/*}/init/bash" /etc/profile.d/lmod.sh /etc/profile.d/modules.sh; do
        if [[ -r $_ws_module_init ]]; then
            # shellcheck disable=SC1090
            source "$_ws_module_init"
            declare -F module >/dev/null && break
        fi
    done
    unset _ws_module_init _ws_lmod
fi
if [[ ${WS_SHELL_PREFLIGHT:-} == 1 && ${WS_SITE_PROMPT_COUNT:-} =~ ^[0-9]+$ ]] && (( WS_SITE_PROMPT_COUNT <= 128 )); then
    PROMPT_COMMAND=()
    for ((_ws_prompt_index=0; _ws_prompt_index<WS_SITE_PROMPT_COUNT; _ws_prompt_index++)); do
        _ws_prompt_name="WS_SITE_PROMPT_$_ws_prompt_index"
        PROMPT_COMMAND+=("${!_ws_prompt_name}")
        unset "$_ws_prompt_name"
    done
    unset _ws_prompt_index _ws_prompt_name WS_SITE_PROMPT_COUNT
fi
unset WS_SHELL_PREFLIGHT
export EDITOR=nvim
export VISUAL=nvim
export PAGER=less
export LESS=-FRX
export HISTCONTROL=ignoreboth
export HISTSIZE=20000
export HISTFILESIZE=40000
export HISTFILE="${WS_STATE_HOME:-${XDG_STATE_HOME}}/bash-history"
shopt -s histappend checkwinsize
