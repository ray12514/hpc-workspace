#!/workspace-tools/libexec/python3 -I
"""Scope convenience-tool settings without redirecting host applications."""
import os
from pathlib import Path
import sys

root = Path('/workspace-tools')
sys.path.insert(0, str(root / 'lib'))
from tool_environment import apply_overrides

name = Path(sys.argv[0]).name
environment = dict(os.environ)
config = Path.home() / '.config/hpc-workspace/xdg'
if name in ('spf', 'lazygit', 'btop', 'lnav'):
    apply_overrides(environment, {'XDG_CONFIG_HOME': str(config)})
if name == 'tldr':
    apply_overrides(environment, {'TEALDEER_CONFIG_DIR': str(config / 'tealdeer')})
if name == 'uv':
    environment.setdefault('UV_PYTHON_DOWNLOADS', 'never')
if name == 'nvtop':
    # Apptainer --nv binds host NVML here. thin-entry restores the native
    # environment snapshot, so add this directory only for the monitor.
    gpu_libs = Path('/.singularity.d/libs')
    if gpu_libs.is_dir():
        existing = environment.get('LD_LIBRARY_PATH', '')
        environment['LD_LIBRARY_PATH'] = str(gpu_libs) + (':' + existing if existing else '')
binary = str(root / 'libexec' / name)
if name == 'lnav':
    loader, libraries = (root / 'manifests/lnav-loader.txt').read_text().splitlines()
    os.execve(loader, [loader, '--library-path', libraries, binary] + sys.argv[1:], environment)
os.execve(binary, [binary] + sys.argv[1:], environment)
