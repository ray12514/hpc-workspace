#!/usr/bin/env python3
"""Bundle portable sources, installed-package records, and artifact checksums."""
import datetime
import hashlib
import json
from pathlib import Path
import re
import subprocess
import sys
import tarfile

root = Path(__file__).resolve().parents[1]
release = sys.argv[1] if len(sys.argv) > 1 else "0.2.0-preview1"
if not re.fullmatch(r"[A-Za-z0-9_][A-Za-z0-9_.-]{0,127}", release):
    raise SystemExit("Invalid release tag")
directory = root / "dist"
name = "hpc-workspace-core-{}-linux-amd64".format(release)
required = [directory / (name + suffix) for suffix in (".sif", ".docker.tar")]
if not all(path.is_file() for path in required):
    raise SystemExit("Run scripts/export-image first")
source = directory / ("hpc-workspace-source-" + release + ".tar.gz")
if source.exists():
    raise SystemExit("Source archive already exists; use a new release name")

docker = str(root / "scripts/docker-public")
inspected = json.loads(subprocess.check_output(
    [docker, "image", "inspect", "hpc-workspace:" + release], text=True))[0]
if inspected["Os"] != "linux" or inspected["Architecture"] != "amd64":
    raise SystemExit("Release image must be linux/amd64")
if inspected["Config"]["Labels"]["org.opencontainers.image.version"] != release:
    raise SystemExit("Image release label does not match the requested release")


def include(info):
    parts = Path(info.name).parts
    if "__pycache__" in parts or info.name.endswith((".pyc", ".local.json", ".DS_Store")):
        return None
    info.uid = info.gid = 0
    info.uname = info.gname = "root"
    return info


source_commit = None
if (root / ".git").exists():
    clean = subprocess.run(["git", "diff", "--quiet", "HEAD", "--"], cwd=root)
    if clean.returncode:
        raise SystemExit("Commit tracked changes before packaging a release")
    source_commit = subprocess.check_output(
        ["git", "rev-parse", "HEAD"], cwd=root, text=True).strip()
    # Archive committed files only; ignored local files never enter a release.
    subprocess.run(["git", "archive", "--format=tar.gz", "--prefix=hpc-workspace/",
                    "--output", str(source), source_commit], cwd=root, check=True)
else:
    # Keep the build helpers usable from an unpacked source release.
    with tarfile.open(source, "w:gz") as bundle:
        for item in (".dockerignore", ".gitignore", "README.md", "bin", "lib", "profiles",
                     "image", "scripts", "share", "tests", "docs", "examples"):
            bundle.add(root / item, arcname="hpc-workspace/" + item, filter=include)

manifests = directory / ("hpc-workspace-manifests-" + release + ".tar.gz")
with manifests.open("wb") as output:
    subprocess.run([docker, "run", "--rm", "--network", "none", "--read-only",
                    "--entrypoint", "tar", "hpc-workspace:" + release,
                    "-C", "/opt/workspace/manifests", "-czf", "-", "."],
                   stdout=output, check=True)

artifacts = []
for path in required + [source, manifests]:
    digest = hashlib.sha256()
    with path.open("rb") as input_file:
        for block in iter(lambda: input_file.read(1024 * 1024), b""):
            digest.update(block)
    value = digest.hexdigest()
    path.with_name(path.name + ".sha256").write_text(value + "  " + path.name + "\n")
    artifacts.append({"file": path.name, "bytes": path.stat().st_size, "sha256": value})

record = {
    "schema_version": 1,
    "release": release,
    "packaged_at_utc": datetime.datetime.now(datetime.timezone.utc).isoformat(),
    "platform": "linux/amd64",
    "docker_image_id": inspected["Id"],
    "source_git_commit": source_commit,
    "apptainer_converter": "1.5.3",
    "sif_compression": "gzip",
    "artifacts": artifacts,
    "validation_record": "hpc-workspace/docs/validation.md",
    "cluster_execution_tested": False,
}
destination = directory / ("release-" + release + ".json")
destination.write_text(json.dumps(record, indent=2) + "\n")
print(destination)
