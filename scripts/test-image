#!/usr/bin/env bash
set -euo pipefail
workspace_root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
workspace_release="${1:-0.1.0-preview1}"
workspace_fixture=$(mktemp -d "$workspace_root/build/smoke.XXXXXX")
trap 'rm -rf "$workspace_fixture"' EXIT
mkdir -p "$workspace_fixture/home/.agents/skills/research" "$workspace_fixture/state" "$workspace_fixture/project"
printf 'keep my custom skill\n' > "$workspace_fixture/home/.agents/skills/research/SKILL.md"
for workspace_phase in save restore; do
    "$workspace_root/scripts/docker-public" run --rm --platform linux/amd64 \
        --read-only --network none --cap-drop ALL --security-opt no-new-privileges \
        --user "$(id -u):$(id -g)" \
        --env HOME=/home/tester --env USER=tester --env LOGNAME=tester --env TERM=xterm-256color \
        --tmpfs /tmp:rw,mode=1777 \
        --mount "type=bind,src=$workspace_fixture/home,dst=/home/tester" \
        --mount "type=bind,src=$workspace_fixture/state,dst=/workspace-state" \
        --mount "type=bind,src=$workspace_fixture/project,dst=/project" \
        --mount "type=bind,src=$workspace_root/tests,dst=/tests,readonly" \
        --workdir /project "hpc-workspace:$workspace_release" \
        python3 /tests/container-behavior.py "$workspace_phase"
done
