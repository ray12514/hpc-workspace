#!/workspace-tools/libexec/python3 -I
"""Packaged agents retain the user's auth, proxy, and site module environment."""
import os
from pathlib import Path
import sys

root = Path('/workspace-tools')
sys.path.insert(0, str(root / 'lib'))
from tool_environment import apply_overrides
from agent_profiles import launch_profile

name = Path(sys.argv[0]).name
environment = dict(os.environ)
apply_overrides(environment, {'PATH': environment.get('PATH', '') + ':' + str(root / 'agent-bin')})
if not environment.get('SSL_CERT_FILE'):
    for path in ('/etc/ssl/certs/ca-certificates.crt', '/etc/pki/tls/certs/ca-bundle.crt', str(root / 'share/ca-bundle.crt')):
        if Path(path).is_file():
            apply_overrides(environment, {'SSL_CERT_FILE': path})
            break
args = [str(root / 'libexec' / name)]
if name == 'codex':
    args += ['-c', 'check_for_update_on_startup=false']
elif name == 'pi':
    environment.setdefault('PI_SKIP_VERSION_CHECK', '1')
try:
    # Help and account-management commands keep their ordinary native behavior.
    arguments = sys.argv[1:]
    informational = any(item in ('--help', '-h', '--version', '-V', '-v') for item in arguments)
    account = (name == 'codex' and arguments[:1] in (['login'], ['logout'])) or (name == 'pi' and arguments[:1] == ['auth'])
    if not (informational or account):
        arguments, environment, _ = launch_profile(name, arguments, environment)
    if name == 'pi' and not environment.get('NODE_EXTRA_CA_CERTS') and environment.get('SSL_CERT_FILE'):
        environment['NODE_EXTRA_CA_CERTS'] = environment['SSL_CERT_FILE']
    os.execve(args[0], args + arguments, environment)
except (ValueError, OSError, TypeError, KeyError) as exc:
    print('workspace agent: ' + str(exc), file=sys.stderr)
    sys.exit(2)
