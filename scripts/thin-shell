#!/workspace-tools/bin/bash
# Prepare site module functions in a short-lived Bash. Read-only shell
# attributes do not survive exec, so the final workspace Bash can keep the
# site's prompt hook and compose its own prompt around it.
exec /workspace-tools/bin/bash --noprofile --norc -ic '
    # The editor window runs a command shell, then execs a fresh thin-shell
    # when Neovim exits. That command shell has not drawn a prompt yet, so it
    # can export our one-shot bootstrap hook. Restore the already serialized
    # site hooks before a second preflight instead of preserving the bootstrap
    # hook itself, which would source this rcfile recursively.
    if [[ ${WS_SHELL_PREFLIGHT:-} == 1 && ${PROMPT_COMMAND:-} == _ws_initial_prompt ]]; then
        PROMPT_COMMAND=()
        if [[ ${WS_SITE_PROMPT_COUNT:-} =~ ^[0-9]+$ ]] && (( WS_SITE_PROMPT_COUNT <= 128 )); then
            for ((_ws_prior_index=0; _ws_prior_index<WS_SITE_PROMPT_COUNT; _ws_prior_index++)); do
                _ws_prior_name="WS_SITE_PROMPT_$_ws_prior_index"
                PROMPT_COMMAND+=("${!_ws_prior_name}")
            done
            unset _ws_prior_index _ws_prior_name
        fi
    fi
    if [[ ${WS_LAYOUT:-core} == thin-v1 ]] && ! declare -F module >/dev/null; then
        _ws_lmod=${LMOD_CMD:-/nonexistent}
        for _ws_module_init in "${MODULESHOME:-/nonexistent}/init/bash" "${_ws_lmod%/libexec/*}/init/bash" /etc/profile.d/lmod.sh /etc/profile.d/modules.sh; do
            if [[ -r $_ws_module_init ]]; then
                # shellcheck disable=SC1090
                source "$_ws_module_init"
                declare -F module >/dev/null && break
            fi
        done
        unset _ws_module_init _ws_lmod
    fi
    _ws_prompt_count=0
    if [[ ${PROMPT_COMMAND+x} == x ]]; then
        _ws_prompt_decl=$(declare -p PROMPT_COMMAND 2>/dev/null)
        [[ $_ws_prompt_decl =~ ^declare\ -[a-zA-Z]*r[a-zA-Z]*\ PROMPT_COMMAND($|=) ]] && export WS_SITE_PROMPT_READONLY=1
        if (( ${#PROMPT_COMMAND[@]} > 128 )); then
            printf "workspace: too many site prompt hooks to preserve\n" >&2
            exit 1
        fi
        for _ws_prompt_item in "${PROMPT_COMMAND[@]}"; do
            printf -v "WS_SITE_PROMPT_$_ws_prompt_count" %s "$_ws_prompt_item"
            export "WS_SITE_PROMPT_$_ws_prompt_count"
            _ws_prompt_count=$((_ws_prompt_count+1))
        done
    fi
    export WS_SITE_PROMPT_COUNT=$_ws_prompt_count
    while IFS= read -r _ws_function; do
        export -f "$_ws_function"
    done < <(compgen -A function)
    export WS_SHELL_PREFLIGHT=1
    # A packaged Bash can read the bound host /etc/bashrc before --rcfile and
    # inherit a frozen PROMPT_COMMAND. Start without automatic rc files, then
    # source the workspace rcfile at the first interactive prompt. The middle
    # Bash clears any read-only attribute left by site module initialization.
    exec /workspace-tools/bin/bash --noprofile --norc -ic '\''
        export WS_PROMPT_RC=${WS_PROMPT_RC:-/workspace-tools/config/bashrc}
        _ws_initial_prompt() {
            source "$WS_PROMPT_RC" || return
            local _ws_initial_hook
            for _ws_initial_hook in "${PROMPT_COMMAND[@]}"; do
                eval "$_ws_initial_hook"
            done
        }
        export -f _ws_initial_prompt
        export PROMPT_COMMAND=_ws_initial_prompt
        exec /workspace-tools/bin/bash --noprofile --norc -i "$@"
    '\'' thin-shell "$@"
' thin-shell "$@"
